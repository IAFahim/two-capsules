  "cards": [
    {
      "dot": "cyan",
      "title": "The four bottlenecks",
      "items": [
        "Serialization CPU on the server, growing with connections",
        "Egress bandwidth, growing with ghosts and bits per ghost",
        "Prediction CPU on the client: predicted entities times replayed ticks",
        "Link quality: latency, jitter and loss, which is not your code"
      ]
    },
    {
      "dot": "amber",
      "title": "The only two defined bad values",
      "items": [
        "Compression efficiency below seventy percent is flagged by the package",
        "Snapshot size above ninety percent of the max message size is flagged",
        "Everything else has a shape, not a number, and yours will differ",
        "Never trust a quoted millisecond figure you did not measure yourself"
      ]
    },
    {
      "dot": "rose",
      "title": "Markers worth pinning",
      "items": [
        "Prioritize chunks: gathering and sorting, per connection",
        "Relevancy: per-entity relevancy evaluation inside the send system",
        "Can use static optimization: the static skip check",
        "Server fixed update: one whole server tick"
      ]
    },
    {
      "dot": "emerald",
      "title": "Telling them apart",
      "items": [
        "Snapshot size pinned but ghost count flat: bandwidth",
        "Tick batching warnings with snapshots under the ceiling: server CPU",
        "Client spikes on snapshot arrival: prediction replay",
        "High jitter and a wide snapshot age spread: the link"
      ]
    }
  ]
