  "cards": [
    {
      "dot": "cyan",
      "title": "The arithmetic, in order",
      "items": [
        "baseImportance times ticks since last sent, per chunk",
        "Divided by IrrelevantImportanceDownScale if the chunk was all irrelevant",
        "Dropped if below MinSendImportance, then multiplied by 1000",
        "Your scaling function runs, then the list is sorted descending"
      ]
    },
    {
      "dot": "amber",
      "title": "Importance is not relevancy",
      "items": [
        "Importance answers how often: a low chunk waits, it is not forgotten",
        "Relevancy answers whether: an irrelevant ghost is despawned on the client",
        "PrioChunk.isRelevant is a whole-chunk fast path that skips the hash map",
        "Relevancy is also the only structural defence against snapshot wallhacks"
      ]
    },
    {
      "dot": "rose",
      "title": "Where it silently does nothing",
      "items": [
        "No GhostConnectionComponentType on the connection: scaling never runs",
        "MaxIterateChunks too low: the packet goes out half empty",
        "Static optimization before the client acks: skipped, no saving",
        "MaxSendEntities in 6.6: obsolete and non-functional"
      ]
    },
    {
      "dot": "emerald",
      "title": "How it degrades with players",
      "items": [
        "Serialization is per connection, with a per-connection acked baseline",
        "Cost is roughly connections times chunks examined times ghosts written",
        "Doubling players roughly doubles send cost with an unchanged world",
        "Tiling fragments chunks, so tile size is a cache decision too"
      ]
    }
  ]
}
