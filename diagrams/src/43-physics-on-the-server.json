  "cards": [
    {
      "dot": "cyan",
      "title": "Where the systems live",
      "items": [
        "Unity Physics declares no world filter of its own",
        "It resolves to local, server and client simulation",
        "So the server solves everything; it just never draws it",
        "Thin clients get no physics at all"
      ]
    },
    {
      "dot": "amber",
      "title": "The re-clocking",
      "items": [
        "Netcode moves the physics group into the prediction loop",
        "The move is a transitive closure over ordering attributes",
        "A replayed tick re-runs broadphase, narrowphase and the solver",
        "Server: one solve per tick. Client: one per replayed tick"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where bandwidth is won",
      "items": [
        "Only velocity has a physics ghost variant, sent to predicting clients",
        "Mass, gravity factor and colliders are never replicated",
        "Static colliders are agreed by baking, not by snapshots",
        "Raise quantization before raising tick rate"
      ]
    }
  ]
