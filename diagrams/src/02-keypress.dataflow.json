  "cards": [
    {
      "dot": "cyan",
      "title": "Why intent and not position",
      "items": [
        "A position from the client is a position the server must trust",
        "A direction is bounded: the server applies its own speed and its own delta",
        "Same movement code both sides means a lying client changes nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "The two groups nobody expects",
      "items": [
        "CopyInputToCommandBuffer \u2014 OrderLast, component to the ring slot for this tick",
        "CopyCommandBufferToInput \u2014 OrderFirst inside prediction, slot back to component",
        "The second is why a replay re-feeds the exact input of every replayed tick"
      ]
    },
    {
      "dot": "rose",
      "title": "What the snapshot arrow really does",
      "items": [
        "Agrees with the prediction: nothing happens, the frame is already correct",
        "Disagrees: restore every predicted ghost to the server tick, replay to now",
        "On the other player's machine the same snapshot is interpolated, not predicted"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three nows on one screen",
      "items": [
        "Your capsule: predicted tick, roughly RTT/2 ahead of the server",
        "Their capsule: interpolated tick, roughly two snapshots behind",
        "The server's truth: rendered by nobody, ever"
      ]
    }
  ]
}