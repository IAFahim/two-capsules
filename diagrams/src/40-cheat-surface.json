  "cards": [
    {
      "dot": "cyan",
      "title": "The model in one sentence",
      "items": [
        "The client sends intent, the server computes results",
        "A direction is bounded; a position would have to be trusted",
        "The same movement rule runs on both sides, so lying changes nothing",
        "Strength equals how much the server derives and how little it accepts"
      ]
    },
    {
      "dot": "amber",
      "title": "Bounded for you, already",
      "items": [
        "At most thirty two commands per packet, five bits of count",
        "A ring of sixty four slots keyed by tick, so flooding buys nothing",
        "Commands older than the current tick are rewritten to it",
        "Interpolation delay is clamped to the collision history size"
      ]
    },
    {
      "dot": "rose",
      "title": "Not bounded — your job",
      "items": [
        "Input field ranges: nothing checks magnitude, sign, or finiteness",
        "Line of sight, weapon range, and fire rate on the server",
        "How much of the world each connection is allowed to receive",
        "Who is allowed to connect at all, via connection approval"
      ]
    },
    {
      "dot": "emerald",
      "title": "Structural versus detection",
      "items": [
        "Structural: clamps, relevancy allowlists, owner-only components, approval",
        "Detection: aim analysis, packet rate, players sitting on the rewind clamp",
        "Aimbots cannot be prevented by authority, only starved of information",
        "On a listen server nothing protects the guests from the host"
      ]
    }
  ]
