  "cards": [
    {
      "dot": "cyan",
      "title": "What crosses the wire",
      "items": [
        "Client to server: PlayerMoveInput, a float2 of intent",
        "Server to client: ghost snapshots, delta-compressed per connection",
        "Carried by NetworkStreamDriver over IPC in-process, UDP otherwise",
        "Nothing else. The client never sends a position."
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation rules",
      "items": [
        "Worlds share no entities, no IDs, no memory",
        "Same frame, sequential \u2014 a server stall stalls the client",
        "WorldSystemFilter decides which world a system exists in at all",
        "MenuWorld lives beside these and is destroyed when the game starts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where a missing entity went",
      "items": [
        "Settings asset not on that world's SettingsAuthoring prefab",
        "Prefab not instantiated in that world's scene",
        "Scene not listed in a SubSceneSet carrying that world's flag",
        "Or the assembly holding it failed its defineConstraints"
      ]
    }
