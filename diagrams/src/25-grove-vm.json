  "cards": [
    {
      "dot": "cyan",
      "title": "One node, four shapes",
      "items": [
        "In the editor it is a box you can drag — source code",
        "After import it is a settings object holding its own opcode — the object file",
        "After bake it is a run of bytes inside one blob — the image",
        "At runtime it is a static method the switch jumps to — the instruction set"
      ]
    },
    {
      "dot": "amber",
      "title": "The opcode, from both ends",
      "items": [
        "Authoring declares it · Grove BovineLabs.Grove.Authoring/Nodes/GroveAuth.cs:21",
        "Code claims it · Grove BovineLabs.Grove/Attributes/ExecuteNodeAttribute.cs:13",
        "The generator matches on the attribute name · Grove SourceGenerator~/NodeFilter.cs:20",
        "Canopy takes a negative range · Canopy BovineLabs.Canopy.Data/CanopyExecutionTypes.cs:10"
      ]
    },
    {
      "dot": "rose",
      "title": "Why a switch and not a delegate",
      "items": [
        "A blob is relocatable bytes, so it cannot hold a function pointer",
        "So the instruction stores an int, and the decode has to live in code",
        "The generator emits that decode · Grove SourceGenerator~/ContextGenerator.cs:294",
        "Burst turns a dense int switch into a jump table, and can inline through it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reading the pipeline in source",
      "items": [
        "Importer · Grove BovineLabs.Grove.Editor/GroveImporter.cs:19",
        "Blob layout · Grove BovineLabs.Grove/GraphData.cs:17, root pointer at :23",
        "Instruction · Grove BovineLabs.Grove/Core/ExecutionHeader.cs:13",
        "Entry point · Grove BovineLabs.Grove/Core/ExecutionHeaderExtensions.cs:15"
      ]
    }
  ]
