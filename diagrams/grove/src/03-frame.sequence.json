  "cards": [
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "GraphImpl lives for the system lifetime",
        "GraphExecution is a value built each update",
        "SetChunk is mandatory before per-entity Execute"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inputs are state",
      "items": [
        "TrySetInput writes GroveState, not stack args",
        "Keys are Hash128 from boundary variable names",
        "TypeHash resolves when only one input of that type exists"
      ]
    },
    {
      "dot": "rose",
      "title": "No interpreter loop",
      "items": [
        "Only Root is kicked for Execute",
        "Nodes recurse via BlobPtr children",
        "Data nodes run only when something Calculate-s them"
      ]
    }
  ]
